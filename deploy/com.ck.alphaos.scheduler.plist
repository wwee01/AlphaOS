<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Research/scan worker only. Monitoring belongs to a separate service.
       Five-minute trigger; existing job windows, caps and fuses still apply.
       Scan admission requires dedicated monitor readiness. -->
  <key>Label</key>
  <string>com.ck.alphaos.scheduler</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/ck/Documents/Claude Playground/AlphaOS/.venv/bin/python</string>
    <string>-m</string>
    <string>alphaos.scheduler.worker</string>
    <string>--role</string>
    <string>research</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/ck/Documents/Claude Playground/AlphaOS</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/ck</string>
  </dict>

  <!-- Fire every 300 seconds, always — the idempotent tick. cadence.py's
       is_due()/is_fused() checks decide what actually runs on any given
       tick; a tick outside every scan window or between monitor/outcomes
       intervals is a cheap, fast no-op (all job types report not_due). -->
  <key>StartInterval</key>
  <integer>300</integer>

  <key>RunAtLoad</key>
  <true/>

  <!-- PR9.5: persistent logs, not /tmp — macOS purges /tmp on reboot and
       periodically, which made the scheduler's own log history disposable.
       ~/Library/Logs/ is the standard macOS location for app logs (visible
       in Console.app) and is included in Time Machine / most backup tools. -->
  <key>StandardOutPath</key>
  <string>/Users/ck/Library/Logs/alphaos/scheduler.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/ck/Library/Logs/alphaos/scheduler-error.log</string>
</dict>
</plist>
