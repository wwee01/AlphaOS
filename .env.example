# ============================================================================
# AlphaOS v1 — example environment configuration
# Copy to `.env` and fill in. NEVER commit a real `.env`.
#
# v1 posture: ONE real market-data path (Alpaca/IEX), NO news (no-news baseline),
# execution is simulated internally, real money is unreachable. In mock/offline
# mode the app runs with ZERO external keys.
# ============================================================================

# --- AI: OpenAI is the primary runtime engine -------------------------------
OPENAI_API_KEY=
OPENAI_PRIMARY_MODEL=gpt-4o-mini

# --- AI: Claude is an OPTIONAL, manual-only second-opinion reviewer ----------
# If empty, the "Request Claude second opinion" button is disabled.
ANTHROPIC_API_KEY=
CLAUDE_REVIEW_MODEL=claude-sonnet-4-6

# --- Market data: Alpaca is the SOLE active provider in v1 (free IEX tier) ---
# DATA_PROVIDER must be 'alpaca' in v1 (anything else fails fast on startup).
DATA_PROVIDER=alpaca
MARKET_DATA_FEED=iex
# Live market data reuses the Alpaca credentials below. Missing creds in live
# mode do NOT silently fall back to any other source — data is blocked instead.

# --- News: OFF in v1 (no-news momentum baseline) ----------------------------
# NEWS_ENABLED=true is unsupported in v1 and fails fast on startup.
# DISTINCT from NEWS_ENRICHMENT_* below: the momentum eval stays no-news.
NEWS_ENABLED=false
NEWS_PROVIDER=disabled

# --- Catalyst enrichment (Roadmap 2.4): ADVISORY official-news context ------
# Separate layer from the no-news eval above. ADVISORY context only: never
# executes, never bypasses a gate, never mints an official label, never enters
# the momentum eval; fails safe to unavailable on any provider error.
#   alpaca   -> LIVE official news (Benzinga via Alpaca, free, reuses the
#               Alpaca paper creds below; articles read from NewsSet['news'])
#   mock     -> offline deterministic provider (default)
#   disabled -> off
NEWS_ENRICHMENT_PROVIDER=alpaca

# --- last30days research / narrative context (Roadmap 2.5) ------------------
# SEPARATE keyless social/research layer (the globally-installed last30days
# skill). DISABLED by default; advisory CONTEXT only — never executes, never
# bypasses gates/approval, never enters the no-news momentum eval. No code
# vendored into AlphaOS.
LAST30DAYS_ENABLED=false
LAST30DAYS_PROVIDER=mock                 # mock | cli | disabled
# IMPORTANT: last30days requires Python >=3.12 — do NOT rely on system python3 (3.9).
LAST30DAYS_PYTHON=python3.12             # absolute path recommended, e.g. ~/.local/bin/python3.12
LAST30DAYS_REPO_PATH=                    # dir with scripts/last30days.py ("" = auto-resolve newest install)
# LAST30DAYS_CMD=                        # full command-template override; placeholders {topic} {sources} {python} {repo}
LAST30DAYS_SOURCES=reddit,hackernews,polymarket,github   # keyless only (no X / yt-dlp / ScrapeCreators yet)
LAST30DAYS_PROFILE=quick                 # quick | deep
LAST30DAYS_TIMEOUT_SECONDS=45            # per-symbol hard cap
LAST30DAYS_MAX_SYMBOLS_PER_SCAN=10       # enrich top-N by interest rank; the rest -> skipped_budget_cap
LAST30DAYS_MAX_THEMES=5
LAST30DAYS_LOOKBACK_HOURS=720            # 30 days
LAST30DAYS_FEED_TO_LABELLER=true         # false = journal/dashboard only (if narrative is noisy)
LAST30DAYS_FAIL_OPEN_AS_UNAVAILABLE=true

# --- Gated labeller decision override (Roadmap 2.6) -------------------------
# Default OFF -> the AI label is DOWNGRADE-ONLY (can restrict, never create a
# proposal). When ON, the label may move the eval's call UP or DOWN — but ONLY
# when ARMED: real AI (OpenAI key, not mock) AND a live catalyst/sentiment driver
# (mock/'unknown' signals never arm it). It still cannot bypass the risk/freshness
# gates, skip manual approval, upgrade a data-integrity reject, or execute. Every
# move is tagged + its driver recorded (decision_adjustments) for learning.
LABELLER_DECISION_OVERRIDE_ENABLED=false

# --- Labeller fail-safe VISIBILITY (health only; never changes behaviour) ----
# A failing labeller fails safe to Other/Unclassified + reject, which looks like
# a conservative decision and can silently block ALL proposals. These thresholds
# only drive a warn/critical health signal (status / dashboard / daily report)
# when the recent fail-safe rate is high; they never touch the fail-safe itself.
LABELLER_FAILSAFE_WARN_RATE=0.25
LABELLER_FAILSAFE_CRITICAL_RATE=0.50
LABELLER_FAILSAFE_MIN_SAMPLE=5

# --- last30days narrative polarity (Roadmap 2.7) ---------------------------
# LLM classifies live last30days clusters into bullish/bearish/neutral/unclear +
# narrative-driver type. Aligned high-confidence polarity can ARM an override
# upgrade; it NEVER trades, bypasses a gate, or skips approval. Hype/meme/squeeze
# => high_risk_narrative (manual-only, warned), not auto-suppressed. Safe defaults:
# disabled + arming OFF; invalid/low-confidence/low-coverage => non-arming.
LAST30DAYS_POLARITY_ENABLED=false
LAST30DAYS_POLARITY_MODEL=                 # blank => OPENAI_PRIMARY_MODEL (gpt-5.4-mini)
LAST30DAYS_POLARITY_MIN_CONFIDENCE=0.6
LAST30DAYS_POLARITY_MIN_SOURCE_COVERAGE=medium   # low | medium | high
LAST30DAYS_POLARITY_ARMING_ALLOWED=false   # must be true (with override) for polarity to arm
LAST30DAYS_HIGH_RISK_NARRATIVE_MANUAL_ONLY=true  # hype/meme/squeeze never auto-approved

# --- Broker / data credentials: Alpaca PAPER ONLY ---------------------------
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Execution -------------------------------------------------------------
# simulated_internal : fills are simulated internally (offline-friendly).
# alpaca_paper       : place REAL broker-native bracket orders on the Alpaca
#                      PAPER API (requires ALPHAOS_MODE=paper + Alpaca paper
#                      creds; still NO real money). A fill is only ever labelled
#                      alpaca_paper when it comes from the real Alpaca paper API.
# TIME-1 part 4 (2026-08-13): re-synced to match what production actually
# runs -- this line previously still read simulated_internal (the CODE
# default) even though live has run alpaca_paper for all 7 real positions
# to date; a spec reasoned against the stale example value here (see the
# post-review-remediation spec's TIME-1 section).
EXECUTION_PROVIDER=alpaca_paper
ALLOW_REAL_ORDERS=false
REQUIRE_MANUAL_APPROVAL=true

# --- Broker protection watchdog / multi-day TIF policy ----------------------
# gtc | day. Protective (stop/target) legs on any swing-hold bracket
# (max_holding_days >= 1, i.e. may cross a session boundary) use this TIF
# instead of day, so they don't silently expire at session close (root cause
# of the 2026-07-02 META incident). Only max_holding_days==0 (pure intraday)
# keeps day-TIF by default.
PROTECTIVE_ORDER_TIME_IN_FORCE=gtc
REQUIRES_PERSISTENT_PROTECTION=true
# Explicit opt-BACK-IN to the old (dangerous) behavior. Leave false.
# NOTE: PROTECTIVE_ORDER_TIME_IN_FORCE=day + this=false is a rejected config
# combination (would silently apply day-TIF to every swing hold) -- see settings.py.
ALLOW_DAY_TIF_FOR_MULTIDAY_POSITIONS=false
# Consecutive per-position broker-lookup failures before the watchdog
# escalates to CRITICAL/unverifiable and blocks new entries (PR2.6 hardening --
# protection state that can't be confirmed must not be silently treated as safe).
# Must be 1-10: too low escalates on noise, too high (or unbounded) silently
# defeats escalation and reintroduces fail-open behavior.
PROTECTION_CHECK_ERROR_ESCALATION_THRESHOLD=3

# --- ENTRY-TTL-1: working-order staleness watchdog --------------------------
# Auto-cancels an UNFILLED alpaca_paper bracket entry order when its thesis
# has aged out or the market moved decisively past it -- never re-prices,
# never closes a position, never touches protective legs of a filled
# position. Defaults ON: cancellation only ever REDUCES prospective exposure
# (contrast with unattended auto-approval, which ships opt-in because it ADDS
# exposure). Runs regardless of the kill switch (an engaged kill switch that
# left stale GTC entries live at the broker would itself be a hole in it).
ENTRY_ORDER_STALENESS_ENABLED=true
# Trading days (weekends/holidays never count) since submission before the
# TTL leg fires. 0 disables this leg. Must be 0-20 -- see settings.py.
ENTRY_ORDER_TTL_TRADING_DAYS=2
# Adverse move (%) beyond the intended entry before the drift leg fires
# (long: last >= entry*(1+X/100); short: last <= entry*(1-X/100)). 0 disables
# this leg. Must be 0-25 -- see settings.py. Skipped (never guessed) when no
# fresh/usable price snapshot exists; the TTL leg above is unaffected.
ENTRY_ORDER_MAX_ADVERSE_DRIFT_PCT=2.0

# --- TIME-1 part 3: broker-managed time-exit BREACH ALERT (detect-only) ----
# max_holding_days has NEVER bound a live (alpaca_paper) position --
# position_manager.monitor() skips its own _check_exit for broker-managed
# positions (an Alpaca bracket OCO has a stop leg and a target leg but NO
# time leg), so a swing hold can sit open indefinitely past its stamped
# window with monitoring_snapshots dishonestly still reading
# time_stop_status='active'. Parts 1/2 of TIME-1 (the honest status value +
# the "## Needs you" visibility line for a position past its window) are
# ALWAYS ON, independent of this flag -- they cover the operator-visibility
# half of TIME-1 unconditionally.
#
# This flag governs ONLY a second, louder signal on top of that: when true,
# a broker-managed position that reaches its time window fires one
# additional high-priority alert naming the symbol, every monitor pass it
# stays past-window. IMPORTANT -- this flag does NOT close, cancel, or
# otherwise touch anything at the broker. It CANNOT: PositionManager is
# architecturally barred from ever calling the broker directly (a
# pre-existing, deliberately-enforced invariant -- see
# tests/test_entry_ttl.py's own broker-isolation guard); all broker mutation
# is confined to execution/order_manager.py's OrderManager. Actual broker-
# side enforcement (cancel the OCO legs, verify, then close) is a SEPARATE,
# not-yet-built ticket that would have to be routed through OrderManager.
# Flag ON and flag OFF are therefore identical in their effect on any
# position -- only the extra alert differs. Default false.
TIME_EXIT_BREACH_ALERT_ENABLED=false

# --- Notifications (optional) ------------------------------------------------
# ntfy.sh topic for scheduler push alerts (PR9: job failures, self-halt fuse
# trips, dead-man heartbeat staleness). Leave blank to no-op silently -- no
# network call is attempted and nothing is treated as a failure.
NTFY_TOPIC=

# --- Scheduler v1.6: unattended-cadence self-halt fuse + heartbeat (PR9) ----
# Consecutive 'failed' job_runs rows (per job_type) before that job type
# self-halts (skipped by run_due_jobs until a human forces a run). Must be
# 1-20: too low fuses on ordinary transient noise, too high lets a broken job
# type keep retrying unattended indefinitely with no operator awareness.
SCHEDULER_MAX_CONSECUTIVE_FAILURES=3
# Dead-man's-switch staleness window (minutes) for the SEPARATE
# `scheduler_health` LaunchAgent/CLI: how long since the last completed
# job_runs row, during market hours, before it exits 1 + alerts. Must be
# 5-1440.
SCHEDULER_HEARTBEAT_STALE_MINUTES=120

# PRE-1b: once-daily pre-open self-test cadence, "HH:MM" SGT. Runs right
# after the pre-open capture jobs (text_archive_pull at 07:00) so it can
# meaningfully report on what they produced (canary staleness, backup age)
# before the first scan window opens. Audit-fixup HIGH-3 (2026-08-13):
# documented here explicitly so the startup .env-vs-.env.example divergence
# check (config/settings.py::_log_env_divergence) can actually see this key
# -- an undocumented setting is invisible to that checker by construction.
SCHEDULER_PREFLIGHT_TIME=07:15

# --- Runtime safety switches ------------------------------------------------
# mock | paper   (shadow/research are recognized-but-inactive stubs; live is not reachable)
# TIME-1 part 4 audit-fixup (HIGH-3, 2026-08-13): re-synced to paper -- this
# line previously still read mock, which is internally CONTRADICTORY with
# EXECUTION_PROVIDER=alpaca_paper above (settings.py refuses to load that
# combination: "EXECUTION_PROVIDER=alpaca_paper requires ALPHAOS_MODE=paper").
# Matches what production actually runs, same drift class as EXECUTION_
# PROVIDER's own note above. For a fully offline/no-credentials local try-out
# (the previous default's actual purpose), explicitly set ALPHAOS_MODE=mock
# AND EXECUTION_PROVIDER=simulated_internal together -- paper mode also
# requires real ALPACA_API_KEY/ALPACA_SECRET_KEY values below (blank by
# default, on purpose -- never commit real credentials here).
ALPHAOS_MODE=paper
# manual | auto  (auto also requires REQUIRE_MANUAL_APPROVAL=false to take effect)
APPROVAL_MODE=manual
# MUST be exactly "false" in v1. Any other value blocks all order placement.
REAL_TRADING_ENABLED=false
# Explicit offline/mock data toggles (mock mode is always explicit + labelled).
RUN_MODE=
OFFLINE_MODE=false

# --- Risk limits (paper) ----------------------------------------------------
MAX_RISK_PER_TRADE_PCT=0.01
MAX_PAPER_TRADES_PER_DAY=5
MAX_OPEN_POSITIONS=5
MAX_DAILY_LOSS_PCT=0.03
PAPER_EQUITY=100000
MAX_AUTO_APPROVALS_PER_DAY=1
MAX_SPREAD_PCT=0.01
MIN_DOLLAR_VOLUME=2000000

# --- Unattended close-window auto-approval (paper only, NOT PR15/L3) --------
# A second, narrower door into the same APPROVAL_MODE=auto gate stack above --
# for scan windows the operator is asleep for and cannot manually approve
# within a proposal's TTL. Default empty = fully inert. Comma-separated
# HH:MM-HH:MM ranges in ET (matching SCHEDULER_SCAN_WINDOWS' own units), e.g.
# the market-close window: UNATTENDED_APPROVE_WINDOWS=15:45-16:00
UNATTENDED_APPROVE_WINDOWS=
MAX_UNATTENDED_APPROVALS_PER_DAY=1

# --- Trade sizing (stop distance / target reward:risk) ----------------------
# Stop is STOP_LOSS_PCT below entry (long) / above (short). Target sits at that
# distance scaled by TARGET_REWARD_RISK, so the target move = STOP_LOSS_PCT x RR
# (default 0.03 x 1.5 = 4.5%). These drive the mock baseline; for the live
# OpenAI engine the model sets levels but MIN_REWARD_RISK still clamps them.
STOP_LOSS_PCT=0.03                 # stop distance as a fraction of entry (0-0.5)
TARGET_REWARD_RISK=1.5             # target reward:risk (was an implicit 2.0)
MIN_REWARD_RISK=1.2               # reject any proposal below this reward:risk

# INSTR-2/INSTR-3: primary-evaluator prompt version. "v1" (default) is
# byte-identical to the pre-INSTR-2 prompt. "v2" surfaces the live
# evaluator's own ATR-based stop policy into the prompt (ATR_STOP_POLICY
# section) so MIN_REWARD_RISK measures real trade geometry instead of a
# units mismatch (see docs/roadmap/alphaos-evaluator-replay-and-coherence-specs.md,
# INSTR-2). "v3" adds MULTI_DAY_CONTEXT (persisted daily bars + the honest
# trend_rules_v1 measure) ahead of ATR_STOP_POLICY (see
# docs/roadmap/alphaos-instr3-trend-context-spec.md, INSTR-3). Both v2 and
# v3 are gated, operator cutover only after each one's own pre-registered
# proof gate passes -- v3 is PRE-CUTOVER as of this writing (built and
# tested, proof gate not yet run against real data; do not set this to v3
# in production before that gate passes and an operator explicitly decides
# to cut over).
# "v4" (HOLD-2) interpolates the horizon from WHATEVER card ACTIVE_CARD_ID
# resolves to, and -- unlike v1/v2/v3, where the "1-N" text was advisory
# only -- ALSO newly ENFORCES it: a PROPOSE whose max_holding_days falls
# outside that range is rejected (MAX_HOLDING_DAYS_OUT_OF_RANGE), a check
# that v1/v2/v3 never performed at all. Audit-fixup HOLD-2 (S-g): setting
# OPENAI_PROMPT_VERSION=v4 WITHOUT also moving ACTIVE_CARD_ID off its
# default (catalyst_momentum_v2, bound 3) is a live behavior change on its
# own, even though the "1-3" text looks unchanged from v1/v2/v3's "1-5" at
# a glance -- it turns a previously-advisory 1-5 into an ENFORCED 1-3,
# tighter than before. Both axes are meant to move together at cutover
# (see ACTIVE_CARD_ID's own comment below for what moves on its OWN vs
# what additionally moves once OPENAI_PROMPT_VERSION also reaches v4).
# One of: v1 | v2 | v3 | v4.
# TIME-1 part 4 (2026-08-13): re-synced to v4 -- this line previously still
# read v1 while production had already cut over to v4; see EXECUTION_
# PROVIDER's own note above for the same drift class.
OPENAI_PROMPT_VERSION=v4

# HOLD-2 (2026-08-05): which setup card get_default_card() resolves to --
# previously a hardcoded code constant (DEFAULT_CARD_ID). Default
# catalyst_momentum_v2 (that constant's own value) means an unchanged .env
# behaves byte-for-byte like before this setting existed. Validated at
# startup against the on-disk card registry (alphaos/cards/*.yaml) -- an
# unknown id refuses to start, never a silent fallback; it must also be
# state=live_eligible with an integer max_holding_days_default in [1,30]
# (the shadow-only post_earnings_reaction card is refused here, on
# purpose). catalyst_momentum_v3 (10-trading-day holding window, see
# docs/roadmap/alphaos-hold2-10day-window-spec.md) is built and
# registered but NOT cut over -- do not set this to v3 in production
# before its own pre-registered proof gate passes and an operator
# explicitly decides to cut over (same discipline as OPENAI_PROMPT_
# VERSION above).
#
# Audit-fixup HOLD-2 round 2 (FIX-C, audit A NEW-6, NIT): this axis is NOT
# inert on its own -- moving it alone (OPENAI_PROMPT_VERSION unchanged)
# already moves THREE real things: (1) every new candidate's/proposal's
# card_id/card_version/invalidation_reason (candidate_scanner.py,
# orchestrator.py's card-stamping call sites), (2) the candidate-stage
# earnings-proximity window (earnings_within_hold_window -- see
# earnings_enricher.py), and (3) the MOCK evaluator's own max_holding_days
# (OpenAIClient._mock_max_holding_days). What it does NOT move on its own
# is prompt TEXT: v1/v2/v3 hardcode "swing horizon 1-5 trading days" (and
# schema "integer 1-5") forever, by design, regardless of this setting.
# Only once OPENAI_PROMPT_VERSION ALSO reaches v4 does the prompt's own
# horizon text (and its new enforced range check) start reading THIS
# card's max_holding_days_default too -- see OPENAI_PROMPT_VERSION's own
# comment above for that direction's warning.
# TIME-1 part 4 (2026-08-13): re-synced to catalyst_momentum_v3 -- this line
# previously still read catalyst_momentum_v2 while production had already
# cut over (HOLD-2, 2026-08-07); see EXECUTION_PROVIDER's own note above for
# the same drift class.
ACTIVE_CARD_ID=catalyst_momentum_v3

# --- Data freshness gate (Alpaca/IEX aware) ---------------------------------
MAX_QUOTE_AGE_SECONDS_RTH=60
MAX_BAR_AGE_SECONDS_RTH=180
MAX_QUOTE_AGE_SECONDS_PREMARKET=300
MAX_BAR_AGE_SECONDS_PREMARKET=600
MAX_PRICE_DRIFT_BPS_SINCE_PROPOSAL=50
# Legacy single-age knob (kept for back-compat; the per-session knobs above win).
MAX_DATA_AGE_SECONDS=120

# --- Cost model (realistic-cost accounting; net P&L = gross - costs) ---------
COST_COMMISSION_PER_SHARE=0.0     # Alpaca US equities: $0
COST_MIN_COMMISSION=0.0           # per-fill floor
COST_SLIPPAGE_BPS=1.0             # per side (entry + exit)

# --- Console API bind + origin allowlist (ND-8: Tailscale access) ----------
# Loopback-only by DEFAULT -- leave both blank/unset for byte-identical
# behavior to before this setting existed (127.0.0.1:8601, loopback-only
# origin allowlist). Setting CONSOLE_BIND_HOST to a Tailscale IP (100.x.y.z)
# exposes the console on the tailnet ONLY, not the LAN, not the internet --
# see console/README.md's "Tailscale access" section (run
# deploy/tailscale_console_env.sh to get these two values + exact lines for
# your machine). Do NOT set CONSOLE_BIND_HOST=0.0.0.0 unless you specifically
# want to expose the console to your entire LAN -- that is honored if set,
# but it is not what the Tailscale setup needs. Audit-fixup note (scope/
# safety LOW): in ANY non-loopback bind (0.0.0.0 or a raw LAN IP -- not the
# Tailscale case, where the tailnet's own auth already covers this), the
# console PIN protects WRITES only. Every read route (positions, P&L,
# decisions, governance) is served to anyone who presents the trivially-
# forgeable X-AlphaOS-Console header -- there is no read-side authentication
# at all. Treat a LAN/internet-facing bind as "readable by anyone who can
# reach the port," not merely "unwritable without the PIN."
# CONSOLE_BIND_HOST=127.0.0.1
# CONSOLE_PORT=8601
# Comma-separated extra origins the security middleware accepts, ON TOP OF
# the loopback origins it always accepts unconditionally. e.g.:
# CONSOLE_ALLOWED_ORIGINS=http://100.64.1.2:8601,http://mac-mini.tailnet-name.ts.net:8601
CONSOLE_ALLOWED_ORIGINS=

# --- Storage / dev ----------------------------------------------------------
ALPHAOS_DB_PATH=data/alphaos.db
ALPHAOS_JSONL_MIRROR=false

# --- EARN-1: live earnings-calendar provider (optional) ---------------------
# Free tier (alphavantage.co), 25 req/day; the once-daily capture job needs 1.
# Leave blank/unset to stay on the deterministic mock provider (the default;
# EARNINGS_PROXIMITY_PROVIDER must ALSO be set to alpha_vantage to go live —
# setting the key alone does not switch providers).
# ALPHA_VANTAGE_API_KEY=
# EARNINGS_PROXIMITY_PROVIDER=alpha_vantage   # default: mock

# --- HGEN-1: the Hypothesis Proposer (shadow, registry-first) --------------
# Draft quarantine + deterministic substrate (schema validation, duplicate
# detection, mechanical risk classification) are ALWAYS active, zero cost.
# This flag gates ONLY the LLM-calling layer (a genuinely paid call, same
# cost posture as CANARY/DEBATE_SHADOW_ENABLED -- default off).
HYPOTHESIS_GEN_SHADOW_ENABLED=false
# Recurring (scheduled) generation is NOT built in this release (no
# scheduler job, no cron wiring) -- this flag is a future arming, inert
# today. Cannot be true while HYPOTHESIS_GEN_SHADOW_ENABLED is false.
HYPOTHESIS_GEN_RECURRING_ENABLED=false
# A tighter daily sub-cap nested inside SCHEDULER_AI_COST_CAP_CALLS_PER_30D
# above (must not exceed 25% of it, same joint validation as
# DEBATE_MAX_CALLS_PER_DAY).
HYPOTHESIS_GEN_MAX_CALLS_PER_DAY=5
# Max raw candidates one generation call may produce (1-20).
HYPOTHESIS_GEN_MAX_PROPOSALS_PER_RUN=3

# --- EXP-1: shadow-tier AI labelling (the arming event for EXP-0's capture) --
# SEPARATE from SHADOW_TIER_ENABLED above: that flag controls deterministic
# capture (zero AI calls); this one controls whether the shadow-tier shortlist
# ever gets a REAL AI label. Defaults false at merge — the spec's own go-live
# order needs 2-4 weeks of real instr1 shadow data before the mechanism-3
# saturation audit (scripts/shadow_saturation_audit.py) can set
# interest_score_shadow_v1's literals from evidence. Arming is a deliberate,
# later, explicit operator decision, never a side effect of shipping this.
SHADOW_LABELLING_ENABLED=false
SHADOW_LABEL_TOP_K=5               # per-window shortlist size (1-25; founder-owned)
SHADOW_EXPLORE_FRACTION=0.2        # fraction of K drawn from below the rank cut
# A tighter sub-cap nested inside SCHEDULER_AI_COST_CAP_CALLS_PER_30D above
# (must not exceed 25% of it, same joint validation as DEBATE_MAX_CALLS_PER_DAY/
# HYPOTHESIS_GEN_MAX_CALLS_PER_DAY).
SHADOW_AI_CAP_CALLS_PER_30D=500
SHADOW_AI_CAP_CALLS_PER_DAY=15      # independent of both 30-day caps (default 3x K)
# Trailing 14-day median feed_coverage floor to ARM labelling; below this,
# every tick refuses with zero calls (checked at RUN time, never assumed).
SHADOW_LABEL_MIN_FEED_COVERAGE=0.80
# SUSP-1: recency window (days) for the canary-aware auto-suspend arm (7-90).
# A CANARY Tier-1 trigger row only latches the suspend while inside this
# window of its started_at_utc; the weekly canary cadence means real drift
# always refreshes the window, so a row aging out means the drift stopped
# recurring -- the operator-resolved case, not a bespoke un-arm mechanism.
SHADOW_SUSPEND_CANARY_WINDOW_DAYS=14

# --- Deferred providers — NOT used in v1 (see connectors/deferred/DEFERRED.md) ---
# MASSIVE_API_KEY=        # deferred — not used in v1
# BENZINGA_API_KEY=       # deferred — not used in v1
